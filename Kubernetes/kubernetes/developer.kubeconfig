apiVersion: v1
kind: Config
clusters:
- name: microk8s
  cluster:
    server: https://127.0.0.1:16443
    certificate-authority-data: 
contexts:
- name: developer-context
  context:
    cluster: microk8s
    user: developer
    namespace: default
current-context: developer-context
users:
- name: developer
  user:
    client-certificate: /home/user/netologi/homework/Kubernetes/kubernetes/developer.crt
    client-key: /home/user/netologi/homework/Kubernetes/kubernetes/developer.key
